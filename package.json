{
  "name": "bb-plugin-devin-agent",
  "version": "0.1.0",
  "description": "BB plugin that runs threads through the Devin CLI's ACP server.",
  "keywords": [
    "bb-plugin",
    "devin",
    "acp",
    "provider"
  ],
  "homepage": "https://github.com/iamEvanYT/bb-plugin-devin-agent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamEvanYT/bb-plugin-devin-agent.git"
  },
  "bugs": {
    "url": "https://github.com/iamEvanYT/bb-plugin-devin-agent/issues"
  },
  "author": {
    "name": "Evan",
    "url": "https://github.com/iamEvanYT"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "bb": ">=0.41",
    "bbPluginSdk": ">=0.6.99"
  },
  "scripts": {
    "build": "bb plugin build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.ts",
    "check": "npm run format:check && npm run typecheck && npm test"
  },
  "bb": {
    "name": "Devin",
    "description": "Run BB threads through the Devin CLI (devin acp).",
    "branding": {
      "icon": "./icons/devin.svg"
    },
    "server": "./src/server.ts",
    "host": "./src/host.ts"
  },
  "dependencies": {
    "@get-bb/plugin-sdk": "^0.6.157"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0"
  }
}
